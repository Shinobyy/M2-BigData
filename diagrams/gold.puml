@startuml gold

title Gold — fact constellation + vues cloisonnées par usage

legend right
  * = clé de tri (ORDER BY) = clé de déduplication
  RMT(col) = ReplacingMergeTree versionné sur col
  stay_id = dimension dégénérée partagée, jamais une FK entre facts
end legend

package "Dimensions" {
  entity dim_patient <<RMT(_ingested_at)>> {
    * patient_id : String
    --
    birth_date : Date32
    sex : String
    region_code : String
    age_group : String
    .. technique ..
    _ingested_at : DateTime
  }

  entity dim_service <<RMT(_ingested_at)>> {
    * service_code : String
    --
    service_label : String
    .. technique ..
    _ingested_at : DateTime
  }

  entity dim_cim10 <<RMT(_ingested_at)>> {
    * code_cim10 : String
    --
    libelle : String
    .. technique ..
    _ingested_at : DateTime
  }
}

package "Facts" {
  entity fact_sejours <<RMT(_processed_at)>> {
    * service_code : String
    * admission_ts : DateTime
    * stay_id : String
    --
    patient_id : String
    discharge_ts : Nullable(DateTime)
    duree_sejour_h : Nullable(Float64)
    admission_mode : String
    discharge_mode : String
    readmission_30j : UInt8
    .. technique ..
    _ingested_at : DateTime
    _processed_at : DateTime
  }

  entity fact_monitoring <<MergeTree>> {
    * stay_id : String
    * ts : DateTime
    --
    patient_id : String
    service_code : String
    heart_rate : Float32
    spo2 : Float32
    temp_c : Float32
    is_alerte_fc : UInt8
    is_alerte_spo2 : UInt8
    is_alerte_temp : UInt8
    .. technique ..
    _ingested_at : DateTime
  }

  entity fact_diagnostics <<RMT(_ingested_at)>> {
    * stay_id : String
    * code_cim10 : String
    --
    patient_id : String
    service_code : String
    type : String
    .. technique ..
    _ingested_at : DateTime
  }
}

package "Vues recherche (SQL SECURITY DEFINER)" {
  entity recherche_prevalence_pathologie <<View>> {
    pathologie : String
    taille_cohorte : UInt64
  }

  entity recherche_cohorte_age_sexe <<View>> {
    age_group : String
    sex : String
    taille_cohorte : UInt64
  }
}

dim_patient ||--o{ fact_sejours : patient_id
dim_service ||--o{ fact_sejours : service_code
dim_patient ||--o{ fact_monitoring : patient_id
dim_service ||--o{ fact_monitoring : service_code
dim_patient ||--o{ fact_diagnostics : patient_id
dim_service ||--o{ fact_diagnostics : service_code
dim_cim10 ||--o{ fact_diagnostics : code_cim10

fact_diagnostics .[#gray].> recherche_prevalence_pathologie : agrège
dim_cim10 .[#gray].> recherche_prevalence_pathologie : agrège
dim_patient .[#gray].> recherche_cohorte_age_sexe : agrège

note as N_degenerate
  stay_id : dimension dégénérée présente
  dans les 3 facts, sans FK de fact à fact.
  Un incident sur un fact n'invalide pas
  les autres. Pour croiser deux facts,
  agréger chacun au grain stay_id AVANT
  de les joindre (sinon fan-out).
end note
fact_sejours .. N_degenerate
fact_monitoring .. N_degenerate
fact_diagnostics .. N_degenerate

note bottom of fact_sejours
  Deux colonnes techniques distinctes :
  _ingested_at  = watermark de lecture
  _processed_at = version d'écrasement
  Nécessaire car readmission_30j
  (lagInFrame sur tout l'historique du
  patient) impose de recalculer d'anciens
  séjours quand le patient revient.
end note

note bottom of recherche_cohorte_age_sexe
  Cloisonnement RGPD :
  - recherche_user n'a SELECT que sur ces
    2 vues, jamais sur les facts au grain fin
  - pilotage_user a SELECT sur les facts et
    dimensions, jamais sur ces vues
  - HAVING taille_cohorte >= 5 : règle des
    petits effectifs, non contournable car
    la vue s'exécute en SECURITY DEFINER
end note

@enduml
